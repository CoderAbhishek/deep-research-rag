# LLM inference — get a free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (Groq-hosted open-weight models)
LLM_MODEL=llama-3.3-70b-versatile

# Embedding model (local, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store path
CHROMA_PERSIST_DIR=./chroma_db

# LangSmith tracing (optional). LANGCHAIN_TRACING_V2=true turns it on;
# LANGSMITH_TRACING=true is the newer name for the same switch.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=deep-research-rag

# Logging verbosity: DEBUG | INFO | WARNING (default INFO)
LOG_LEVEL=INFO
