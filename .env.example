# LLM inference — get a free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Models and paths are set in code (src/pipeline/rag_pipeline.py, src/llm/,
# src/generation/), not here: openai/gpt-oss-20b on Groq, all-MiniLM-L6-v2
# embeddings, ./chroma_db. (LLM_MODEL, EMBEDDING_MODEL and CHROMA_PERSIST_DIR
# used to be listed here but no code read them.)

# LangSmith tracing (optional). LANGCHAIN_TRACING_V2=true turns it on;
# LANGSMITH_TRACING=true is the newer name for the same switch.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=deep-research-rag

# Logging verbosity: DEBUG | INFO | WARNING (default INFO)
LOG_LEVEL=INFO
